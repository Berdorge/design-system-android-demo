<?xml version="1.0" encoding="utf-8"?>
<resources>
    <declare-styleable name="VkSwitchItem">
        <attr name="switchItemTitle" format="string" />
        <attr name="switchItemSubtitle" format="string" />
        <attr name="switchAlignment" format="enum">
            <enum name="start" value="0" />
            <enum name="end" value="1" />
        </attr>
    </declare-styleable>

    <declare-styleable name="VkButton">
        <attr name="android:text" format="string" />
        <attr name="android:paddingHorizontal" format="dimension" />
        <attr name="android:minHeight" format="dimension" />
        <attr name="randomButtonAttribute" format="dimension" />
    </declare-styleable>
</resources>
